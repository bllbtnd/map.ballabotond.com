---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | Balla Botond"
  description="The page you are looking for does not exist."
>
  <main class="h-screen flex flex-col items-center justify-center px-6 text-center">
    <p class="pf-grotesk text-fluid-sm text-pf-accent font-medium tracking-widest uppercase mb-4">404</p>
    <h1 class="pf-serif text-pf-text leading-tight-display mb-6" style="font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem);">
      Lost on the map
    </h1>
    <p class="pf-grotesk text-pf-accent text-fluid-sm max-w-sm mb-10">
      This place doesn't exist — at least not here.
    </p>
    <a
      href="/"
      class="pf-grotesk text-fluid-sm font-medium text-pf-text border-b border-pf-text/40 hover:border-pf-text transition-colors duration-300 pb-0.5"
    >
      Back to the map
    </a>
  </main>
</Layout>
