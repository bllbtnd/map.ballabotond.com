---
import Layout from '../layouts/Layout.astro';
import storiesRaw from '../data/data.json';
import { geocode } from '../utils/geocode';

type StoryItem = {
  id: number;
  photo: string;
  date: string;
  lat: number;
  lng: number;
  label: string;
};

type StorySourceItem = {
  image?: string;
  date?: string;
  location?: string | [number, number];
  coordinate?: [number, number];
  label?: string;
};

const sorted = [...(storiesRaw as StorySourceItem[])].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const stories: StoryItem[] = [];
const visitedCountries = new Set<string>();
const plannedCountries = new Set<string>();

for (const [index, s] of sorted.entries()) {
  const isTravelPlan = !s.image && !s.date && typeof s.location === 'string';

  if (isTravelPlan) {
    if (typeof s.location === 'string') {
      const labelParts = s.location.split(',').map((part) => part.trim()).filter(Boolean);
      if (labelParts.length > 0) {
        plannedCountries.add(labelParts[labelParts.length - 1]);
      }
    }
    continue;
  }

  if (!s.image || !s.date) {
    continue;
  }

  const photo = `/images/${s.image}`;
  let lat = 0;
  let lng = 0;
  let label = '';

  if (!s.location && !s.coordinate) {
    continue;
  } else if (Array.isArray(s.location)) {
    lat = s.location[0];
    lng = s.location[1];
    label = s.label || `${lat.toFixed(2)}, ${lng.toFixed(2)}`;
  } else if (typeof s.location === 'string') {
    label = s.location;
    const labelParts = s.location.split(',').map((part) => part.trim()).filter(Boolean);
    if (labelParts.length > 0) {
      visitedCountries.add(labelParts[labelParts.length - 1]);
    }
    if (s.coordinate) {
      lat = s.coordinate[0];
      lng = s.coordinate[1];
    } else {
      const coords = await geocode(s.location);
      if (coords) {
        lat = coords.lat;
        lng = coords.lng;
      }
    }
  } else if (s.coordinate) {
    lat = s.coordinate[0];
    lng = s.coordinate[1];
    label = `${lat.toFixed(2)}, ${lng.toFixed(2)}`;
  }

  if (lat === 0 && lng === 0) continue;

  stories.push({
    id: index,
    photo,
    date: s.date,
    lat,
    lng,
    label
  });
}
---

<Layout
  title="My Map | Balla Botond"
  description="A map of places I have visited and places I plan to visit."
  keywords="Balla Botond, stories, map, travel, places"
>
  <main class="relative h-screen overflow-hidden">
    <div id="stories-map" class="absolute inset-0 z-0">
      <div id="maplibre-container" style="position:absolute;inset:0;"></div>
      <div id="map-status" class="absolute inset-0 flex items-center justify-center pf-grotesk text-fluid-sm text-pf-accent bg-pf-bg/90">
        Loading map...
      </div>
    </div>

    <div class="absolute inset-0 z-20 pointer-events-none" style="background: linear-gradient(to bottom, rgba(240,235,227,0.9) 0%, rgba(240,235,227,0.62) 22%, rgba(240,235,227,0.05) 48%, rgba(240,235,227,0) 100%);"></div>

    <div class="relative z-30 px-4 sm:px-6 pt-8 md:pt-10 pointer-events-none">
      <div class="max-w-7xl mx-auto">
        <nav class="mb-6 md:mb-7 flex items-center justify-between border-b border-pf-border/70 pb-4 pointer-events-auto">
          <a href="https://ballabotond.com" class="pf-grotesk text-fluid-sm font-medium text-pf-text hover:text-pf-accent transition-colors duration-300">
            Balla Botond
          </a>
        </nav>

        <div class="max-w-2xl">
          <h1 class="pf-serif text-pf-text leading-tight-display tracking-brutal" style="font-size: clamp(2rem, 1.2rem + 4vw, 4.5rem);">
            My Map
          </h1>
        </div>
      </div>
    </div>

    <div id="map-lightbox" class="fixed inset-0 z-[120] hidden items-center justify-center p-4 sm:p-6">
      <button id="map-lightbox-close" type="button" class="absolute top-4 right-4 md:top-6 md:right-6 text-white/80 hover:text-white transition-colors" aria-label="Close">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <button id="map-lightbox-prev" type="button" class="absolute left-4 md:left-6 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/45 p-3 text-white/90 transition hover:bg-black/60 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Previous image">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button id="map-lightbox-next" type="button" class="absolute right-4 md:right-6 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/45 p-3 text-white/90 transition hover:bg-black/60 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Next image">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <div id="map-lightbox-media" class="relative w-full max-w-6xl flex flex-col items-center gap-4">
        <img id="map-lightbox-img" src="" alt="" class="max-w-full max-h-[78vh] object-contain rounded-lg" />

        <div class="w-full max-w-4xl text-center text-white/90 pf-grotesk tracking-[0.04em] uppercase text-fluid-xs flex flex-col gap-1 pb-1">
          <p id="map-lightbox-meta-date"></p>
          <p id="map-lightbox-meta-location" class="text-white"></p>
        </div>
      </div>
    </div>

    <div id="stories-data" style="display:none" data-stories={JSON.stringify(stories)}></div>
    <div id="visited-countries-data" style="display:none" data-countries={JSON.stringify(Array.from(visitedCountries))}></div>
    <div id="planned-countries-data" style="display:none" data-countries={JSON.stringify(Array.from(plannedCountries))}></div>
  </main>

  <div id="page-loader" aria-hidden="true"></div>

</Layout>

<script is:inline>
  function loadScript(url) {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = url;
      script.async = true;
      script.onload = () => resolve(true);
      script.onerror = () => reject(new Error('Failed to load ' + url));
      document.head.appendChild(script);
    });
  }

  function loadCSS(href, id) {
    return new Promise((resolve) => {
      if (document.getElementById(id)) { resolve(); return; }
      const link = document.createElement('link');
      link.id = id;
      link.rel = 'stylesheet';
      link.href = href;
      link.onload = resolve;
      link.onerror = resolve; // don't block on failure
      document.head.appendChild(link);
    });
  }

  async function ensureMapLibre() {
    if (typeof maplibregl !== 'undefined') return true;
    // Wait for CSS before loading JS so the canvas is sized correctly on init
    await loadCSS('https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css', 'maplibre-css');
    for (const url of [
      'https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js',
      'https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.js',
    ]) {
      try {
        await loadScript(url);
        if (typeof maplibregl !== 'undefined') return true;
      } catch {}
    }
    return false;
  }

  // Polylabel: pole of inaccessibility — the point inside a polygon farthest from any edge.
  // This is how professional mapping tools (Mapbox, etc.) place country labels.
  function polygonArea(ring) {
    let area = 0;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      area += (ring[j][0] + ring[i][0]) * (ring[j][1] - ring[i][1]);
    }
    return Math.abs(area / 2);
  }

  function pointInRing(pt, ring) {
    const [x, y] = pt;
    let inside = false;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const [xi, yi] = ring[i];
      const [xj, yj] = ring[j];
      if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) {
        inside = !inside;
      }
    }
    return inside;
  }

  function segDistSq(px, py, ax, ay, bx, by) {
    let dx = bx - ax, dy = by - ay;
    if (dx !== 0 || dy !== 0) {
      const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)));
      dx = px - (ax + t * dx);
      dy = py - (ay + t * dy);
    } else {
      dx = px - ax; dy = py - ay;
    }
    return dx * dx + dy * dy;
  }

  function pointToRingDist(px, py, ring) {
    let minDist = Infinity;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const d = segDistSq(px, py, ring[j][0], ring[j][1], ring[i][0], ring[i][1]);
      if (d < minDist) minDist = d;
    }
    return Math.sqrt(minDist) * (pointInRing([px, py], ring) ? 1 : -1);
  }

  function polylabel(rings, precision) {
    precision = precision || 0.0001;
    const outer = rings[0];
    let minX = outer[0][0], minY = outer[0][1], maxX = minX, maxY = minY;
    for (const [x, y] of outer) {
      if (x < minX) minX = x; if (x > maxX) maxX = x;
      if (y < minY) minY = y; if (y > maxY) maxY = y;
    }
    const size = Math.min(maxX - minX, maxY - minY);
    let cellSize = size / 16;
    if (cellSize === 0) return [(minX + maxX) / 2, (minY + maxY) / 2];

    // Priority queue (simple array sorted by max potential)
    const queue = [];
    const cellDist = (cx, cy) => {
      let d = pointToRingDist(cx, cy, outer);
      for (let k = 1; k < rings.length; k++) d = Math.min(d, -pointToRingDist(cx, cy, rings[k]));
      return d;
    };
    const addCell = (x, y, h) => {
      const d = cellDist(x, y);
      queue.push({ x, y, h, d, max: d + h * Math.SQRT2 });
    };

    for (let x = minX; x < maxX; x += cellSize) {
      for (let y = minY; y < maxY; y += cellSize) {
        addCell(x + cellSize / 2, y + cellSize / 2, cellSize / 2);
      }
    }

    // Centroid cell as initial best
    let sumX = 0, sumY = 0;
    for (const [x, y] of outer) { sumX += x; sumY += y; }
    const cx = sumX / outer.length, cy = sumY / outer.length;
    let best = { x: cx, y: cy, d: cellDist(cx, cy) };

    while (queue.length) {
      queue.sort((a, b) => b.max - a.max);
      const cell = queue.shift();
      if (cell.d > best.d) best = cell;
      if (cell.max - best.d <= precision) continue;
      const h = cell.h / 2;
      addCell(cell.x - h, cell.y - h, h);
      addCell(cell.x + h, cell.y - h, h);
      addCell(cell.x - h, cell.y + h, h);
      addCell(cell.x + h, cell.y + h, h);
    }

    return [best.x, best.y];
  }

  function getLargestPolygonCentroid(feature) {
    const geom = feature?.geometry;
    if (!geom) return null;
    let polygons = [];
    if (geom.type === 'Polygon') {
      polygons = [geom.coordinates];
    } else if (geom.type === 'MultiPolygon') {
      polygons = geom.coordinates;
    }
    if (!polygons.length) return null;

    // Pick polygon with largest outer ring area
    let best = polygons[0];
    let bestArea = polygonArea(best[0]);
    for (const poly of polygons.slice(1)) {
      const a = polygonArea(poly[0]);
      if (a > bestArea) { bestArea = a; best = poly; }
    }

    const [lng, lat] = polylabel(best);
    return { lng, lat };
  }

  async function initMapPage() {
    const hasRuntime = await ensureMapLibre();
    if (!hasRuntime) {
      const mapStatus = document.getElementById('map-status');
      if (mapStatus) mapStatus.textContent = 'Map failed to load';
      return;
    }

    const mapContainer = document.getElementById('stories-map');
    const mapStatus = document.getElementById('map-status');
    const dataEl = document.getElementById('stories-data');
    const visitedCountriesEl = document.getElementById('visited-countries-data');
    const plannedCountriesEl = document.getElementById('planned-countries-data');
    const lightbox = document.getElementById('map-lightbox');
    const lightboxImg = document.getElementById('map-lightbox-img');
    const lightboxClose = document.getElementById('map-lightbox-close');
    const lightboxPrev = document.getElementById('map-lightbox-prev');
    const lightboxNext = document.getElementById('map-lightbox-next');
    const lightboxMetaDate = document.getElementById('map-lightbox-meta-date');
    const lightboxMetaLocation = document.getElementById('map-lightbox-meta-location');
    const lightboxMedia = document.getElementById('map-lightbox-media');
    if (!mapContainer || !dataEl || !visitedCountriesEl || !plannedCountriesEl) return;
    if (!lightbox || !lightboxImg || !lightboxClose || !lightboxPrev || !lightboxNext || !lightboxMetaDate || !lightboxMetaLocation || !lightboxMedia) return;
    if (mapContainer.dataset.initialized === 'true') return;
    mapContainer.dataset.initialized = 'true';

    const stories = JSON.parse(dataEl.getAttribute('data-stories') || '[]');
    const visitedCountries = JSON.parse(visitedCountriesEl.getAttribute('data-countries') || '[]');
    const plannedCountries = JSON.parse(plannedCountriesEl.getAttribute('data-countries') || '[]');
    const homeCountry = 'Hungary';
    const otherVisitedCountries = visitedCountries.filter((country) => country !== homeCountry);
    const travelPlanCountries = plannedCountries.filter((country) => country !== homeCountry && !otherVisitedCountries.includes(country));

    const countryLabelMarkers = [];

    const map = new maplibregl.Map({
      container: 'maplibre-container',
      style: {
        version: 8,
        sources: {
          carto: {
            type: 'raster',
            tiles: [
              'https://a.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png',
              'https://b.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png',
              'https://c.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png',
              'https://d.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png',
            ],
            tileSize: 256,
          }
        },
        layers: [
          { id: 'bg', type: 'background', paint: { 'background-color': '#E6E1D9' } },
          { id: 'carto-tiles', type: 'raster', source: 'carto' },
        ]
      },
      center: [19.5033, 47.1625],
      zoom: 5.5,
      minZoom: 2,
      maxZoom: 15,
      attributionControl: false,
    });

    const dateFormatter = new Intl.DateTimeFormat('en', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });

    let orderedStories = [];
    let currentLightboxIndex = -1;
    let touchStartX = 0;
    let touchStartY = 0;

    function toRadians(value) { return (value * Math.PI) / 180; }

    function distanceInKm(a, b) {
      const earthRadiusKm = 6371;
      const dLat = toRadians(b.lat - a.lat);
      const dLng = toRadians(b.lng - a.lng);
      const haversine = Math.sin(dLat / 2) ** 2 +
        Math.sin(dLng / 2) ** 2 * Math.cos(toRadians(a.lat)) * Math.cos(toRadians(b.lat));
      return 2 * earthRadiusKm * Math.asin(Math.sqrt(haversine));
    }

    function buildNearestPath(startStory) {
      const remaining = stories.filter((item) => item.id !== startStory.id);
      const nearestPath = [startStory];
      let current = startStory;
      while (remaining.length > 0) {
        let nearestIndex = 0;
        let nearestDistance = Number.POSITIVE_INFINITY;
        for (let i = 0; i < remaining.length; i++) {
          const d = distanceInKm(current, remaining[i]);
          if (d < nearestDistance) { nearestDistance = d; nearestIndex = i; }
        }
        const [nearestStory] = remaining.splice(nearestIndex, 1);
        nearestPath.push(nearestStory);
        current = nearestStory;
      }
      return nearestPath;
    }

    function updateLightboxStory(index) {
      if (index < 0 || index >= orderedStories.length) return;
      currentLightboxIndex = index;
      const story = orderedStories[index];
      map.easeTo({ center: [story.lng, story.lat], duration: 550 });
      lightboxImg.src = story.photo;
      lightboxImg.alt = story.label;
      lightboxMetaDate.textContent = story.date ? dateFormatter.format(new Date(story.date)) : '';
      lightboxMetaLocation.textContent = story.label || '';
      lightboxPrev.disabled = index === 0;
      lightboxNext.disabled = index === orderedStories.length - 1;
    }

    function openLightbox(story) {
      orderedStories = buildNearestPath(story);
      updateLightboxStory(0);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('active');
    }

    function showPreviousStory() {
      if (currentLightboxIndex > 0) updateLightboxStory(currentLightboxIndex - 1);
    }

    function showNextStory() {
      if (currentLightboxIndex < orderedStories.length - 1) updateLightboxStory(currentLightboxIndex + 1);
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('active');
      lightboxImg.src = '';
      lightboxMetaDate.textContent = '';
      lightboxMetaLocation.textContent = '';
      orderedStories = [];
      currentLightboxIndex = -1;
    }

    if (!lightbox.dataset.bound) {
      lightboxClose.addEventListener('click', closeLightbox);
      lightboxPrev.addEventListener('click', showPreviousStory);
      lightboxNext.addEventListener('click', showNextStory);
      lightboxMedia.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });
      lightboxMedia.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) < 40 || Math.abs(dy) > 70) return;
        dx > 0 ? showPreviousStory() : showNextStory();
      }, { passive: true });
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
        if (!lightbox.classList.contains('active')) return;
        if (e.key === 'ArrowLeft') showPreviousStory();
        if (e.key === 'ArrowRight') showNextStory();
      });
      lightbox.dataset.bound = 'true';
    }

    const loader = document.getElementById('page-loader');
    let loaderDone = false;
    function fadeOutLoader() {
      if (loaderDone || !loader) return;
      loaderDone = true;
      loader.classList.add('fade-out');
      loader.addEventListener('transitionend', () => loader.remove(), { once: true });
    }

    // Safety timeout — hide loading indicator even if tiles are slow
    setTimeout(() => {
      if (mapStatus) mapStatus.classList.add('hidden');
      fadeOutLoader();
    }, 3000);

    map.on('load', async () => {
      map.resize();
      if (mapStatus) mapStatus.classList.add('hidden');
      fadeOutLoader();

      let countriesData = null;
      for (const url of [
        'https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson',
        'https://cdn.jsdelivr.net/gh/datasets/geo-countries@master/data/countries.geojson',
      ]) {
        try {
          const r = await fetch(url);
          if (r.ok) { countriesData = await r.json(); break; }
        } catch {}
      }

      if (countriesData) {
        const homeFeatures = [], visitedFeatures = [], plannedFeatures = [], labelPoints = [];
        for (const feature of countriesData.features) {
          const name = feature.properties?.name;
          let highlighted = false;
          if (name === homeCountry) { homeFeatures.push(feature); highlighted = true; }
          else if (otherVisitedCountries.includes(name)) { visitedFeatures.push(feature); highlighted = true; }
          else if (travelPlanCountries.includes(name)) { plannedFeatures.push(feature); highlighted = true; }
          if (highlighted) {
            const center = getLargestPolygonCentroid(feature);
            if (center) labelPoints.push({
              type: 'Feature',
              geometry: { type: 'Point', coordinates: [center.lng, center.lat] },
              properties: { name }
            });
          }
        }

        const makeFC = (features) => ({ type: 'FeatureCollection', features });

        map.addSource('countries-home', { type: 'geojson', data: makeFC(homeFeatures) });
        map.addLayer({ id: 'home-fill', type: 'fill', source: 'countries-home', paint: { 'fill-color': '#3F7C85', 'fill-opacity': 0.5 } });
        map.addLayer({ id: 'home-line', type: 'line', source: 'countries-home', paint: { 'line-color': '#2E646B', 'line-width': 1.8 } });

        map.addSource('countries-visited', { type: 'geojson', data: makeFC(visitedFeatures) });
        map.addLayer({ id: 'visited-fill', type: 'fill', source: 'countries-visited', paint: { 'fill-color': '#7A6C5D', 'fill-opacity': 0.38 } });
        map.addLayer({ id: 'visited-line', type: 'line', source: 'countries-visited', paint: { 'line-color': '#6B5D50', 'line-width': 1.4 } });

        map.addSource('countries-planned', { type: 'geojson', data: makeFC(plannedFeatures) });
        map.addLayer({ id: 'planned-fill', type: 'fill', source: 'countries-planned', paint: { 'fill-color': '#B792C8', 'fill-opacity': 0.34 } });
        map.addLayer({ id: 'planned-line', type: 'line', source: 'countries-planned', paint: { 'line-color': '#9A6FB0', 'line-width': 1.6, 'line-dasharray': [6, 4] } });

        for (const point of labelPoints) {
          const el = document.createElement('span');
          el.className = 'country-label';
          el.textContent = point.properties.name;
          const marker = new maplibregl.Marker({ element: el, anchor: 'center' })
            .setLngLat(point.geometry.coordinates)
            .addTo(map);
          countryLabelMarkers.push(el);
        }

        function updateLabelSizes() {
          const zoom = map.getZoom();
          const size = Math.max(0, Math.min(13, (zoom - 3) * 2.5));
          const opacity = zoom < 3.5 ? 0 : Math.min(0.35, (zoom - 3.5) * 0.35);
          for (const el of countryLabelMarkers) {
            el.style.fontSize = size + 'px';
            el.style.opacity = String(opacity);
          }
        }

        updateLabelSizes();
        map.on('zoom', updateLabelSizes);
      }

      for (const story of stories) {
        const el = document.createElement('button');
        el.type = 'button';
        el.className = 'map-photo-marker';
        el.style.backgroundImage = `url(${story.photo})`;
        el.setAttribute('aria-label', story.label);
        el.title = story.label;
        el.addEventListener('click', () => openLightbox(story));
        new maplibregl.Marker({ element: el }).setLngLat([story.lng, story.lat]).addTo(map);
      }
    });

    map.on('error', () => {
      if (mapStatus) { mapStatus.textContent = 'Map failed to load'; mapStatus.classList.remove('hidden'); }
      fadeOutLoader();
    });
  }

  initMapPage();
</script>

<style is:global>
  .map-photo-marker {
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    border: 2px solid #F0EBE3;
    box-shadow: 0 6px 16px rgba(26, 26, 26, 0.22);
    background-size: cover;
    background-position: center;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

